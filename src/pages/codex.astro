---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import { FEATURES, SITE } from '../config';
import { catStyle, fmt } from '../lib/constants';
import { getAgents } from '../lib/data';

const agents = await getAgents();
const top = [...agents]
  .sort((a, b) => b.copies - a.copies || a.name.localeCompare(b.name))
  .slice(0, 10);

const title = `Codex Agent Prompts & Directory | ${SITE.wordmark}`;
const description =
  'Browse ready-to-use Codex prompts for email, marketing, sales, operations, and more. Copy a workflow and set up a scheduled agent in minutes.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Codex agent prompt directory',
    url: `${SITE.url}/codex/`,
    description,
    isPartOf: { '@type': 'WebSite', name: SITE.wordmark, url: SITE.url },
    about: { '@type': 'Thing', name: 'Codex', url: SITE.codexUrl },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: agents.length,
      itemListElement: top.map((agent, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: agent.name,
        url: `${SITE.url}/agents/${agent.slug}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'All agents', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Codex prompts', item: `${SITE.url}/codex/` },
    ],
  },
];
---

<Base title={title} description={description} structuredData={structuredData}>
  <Header />

  <article class="agent-article">
    <div class="breadcrumb">
      <a href="/">All agents</a>
      <span>/</span>
      <span>Codex</span>
    </div>

    <h1 class="agent-title">Codex prompts and workflows</h1>

    <section class="prompt-section">
      <h2 class="section-title" style="margin-bottom: 12px;">What is Codex?</h2>
      <p class="section-note" style="margin: 0;">
        <a href={SITE.codexUrl}>Codex</a> is OpenAI's agent for real software work — writing code, running tasks,
        connecting tools, and keeping schedules. You describe the job once, it asks for the connections it needs,
        then keeps running until told otherwise. The <a href={SITE.codexCliUrl}>Codex CLI</a> runs the same agents
        from your terminal.
      </p>
    </section>

    <section class="connect-section">
      <h2 class="section-title">Prompts that run in Codex</h2>
      <p class="section-note" style="margin: 12px 0 16px;">
        Every agent in this directory is a copy-paste prompt published as an editable Markdown file in a public GitHub
        repository. The same prompts also run in any other agent you already use. Here are ten to get started:
      </p>
      <div class:list={['agent-table', { 'hide-copies': !FEATURES.showCopies }]}>
        <div class="agent-table-head">
          <span>Agent</span><span>Category</span><span>Integrations</span>{FEATURES.showCopies && <span>Copies</span>}<span>Source</span>
        </div>
        {
          top.map((b) => (
            <a href={`/agents/${b.slug}/`} class="agent-row">
              <span class="agent-row-namecell">
                <span class="agent-row-nameline">
                  <span class="agent-row-name">{b.name}</span>
                </span>
              </span>
              <span
                class="cat-pill"
                style={`color: ${catStyle(b.category).catFg}; background: ${catStyle(b.category).catBg}; border-color: ${catStyle(b.category).catBorder};`}
              >{b.category}</span>
              <span class="agent-row-tools">{b.integrations.join(', ')}</span>
              {FEATURES.showCopies && <span class="agent-row-copies">{fmt(b.copies)} copies</span>}
              <span class="agent-row-contrib">{b.contributor ? `@${b.contributor}` : '—'}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="cta-card">
      <div>
        <p class="cta-title">Browse all {agents.length} agents</p>
        <p class="cta-sub">Filter by category or integration, copy a prompt, done.</p>
      </div>
      <div class="cta-actions">
        <PrimaryButton href="/" height={44}>Browse the directory</PrimaryButton>
        <a href={SITE.repoUrl} class="btn-view-source">Add your agent</a>
      </div>
    </section>
  </article>

  <Footer />
</Base>
